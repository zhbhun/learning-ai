{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.js",
    "assets/**/*.js",
    "cheatsheets/**/*.ts"
  ]
}
